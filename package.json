{
  "name": "snmp-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot index.ts",
    "start": "bun index.ts",
    "build:frontend": "bun build frontend/index.html --outdir frontend/dist",
    "build:sidecar": "bun scripts/build-tauri-sidecar.ts",
    "build:desktop": "bun run build:frontend && bun run build:sidecar",
    "desktop:dev": "cd desktop && bunx tauri dev",
    "desktop:build": "cd desktop && bunx tauri build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ptrsnake/ts-snmp": "^1.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/bun": "latest",
    "typescript": "^7"
  }
}
